[general]
calculate_target=Cumulant
calculate_algorithm=AVL Based algorithm
source_grid=@MOVING_WINDOW_FIXTURE_DIR@/window_3x3.grid
source_property=value
coordinate_dimensions=2
target_property=exhaustive_smoke

[template_shape]
template_sampling=exhaustive_integer_offsets
NOD=2,1
NLAG=2,2
LAG=1,1
LTOL=0,0
AZM=0,90
ATOL=0,0
BANDWH=0,0
DIP=0,0
DTOL=0,0
BANDWD=0,0
integer_direction_vectors=1,0;0,1
source_spacing=50,50,2

[target_cross_sections]
displayed_dirs=1,2
fixed_positions=

[runtime]
output_dir=@TEMPLATE_EXHAUSTIVE_SMOKE_OUTPUT_DIR@
