# Preserve legacy source bytes and encodings; CRLF is intentional in VC2008 files.
# No repository-wide line-ending conversion is performed.
*.cpp -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.h -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.vcproj -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.ui -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.py -text
*.png binary
*.tif binary
*.tiff binary
*.jpg binary
*.pdf binary
*.dll binary
*.sgems binary
*.cmd text eol=crlf
*.ps1 text eol=crlf
# Archived research evidence is checksum-bound; never normalize its bytes.
Paper-data/current_results/** -text
