<connections>
    <connection>
        <sender>Source_Grid</sender>
        <signal>activated(const QString&amp;)</signal>
        <receiver>Source_Property</receiver>
        <slot>show_properties(const QString&amp;)</slot>
    </connection>
    <connection>
        <sender>Output_3D_Slice_Source_Grid</sender>
        <signal>activated(const QString&amp;)</signal>
        <receiver>Output_3D_Slice_Source_Property</receiver>
        <slot>show_properties(const QString&amp;)</slot>
    </connection>
</connections>
